{
	"name": "@pos-nfce/frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Frontend PWA - Sistema POS com NFC-e",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"typecheck": "vue-tsc --noEmit",
		"clean": "rm -rf dist coverage .tsbuildinfo node_modules/.vite",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@pos-nfce/shared": "workspace:*",
		"drizzle-orm": "0.44.7",
		"pinia": "3.0.4",
		"sql.js": "1.13.0",
		"vue": "3.5.24",
		"vue-router": "4.6.3"
	},
	"devDependencies": {
		"@types/node": "24.10.1",
		"@types/sql.js": "1.4.9",
		"@vitejs/plugin-vue": "6.0.1",
		"@vitest/coverage-v8": "4.0.9",
		"@vitest/ui": "4.0.9",
		"@vue/test-utils": "2.4.6",
		"drizzle-kit": "0.31.7",
		"happy-dom": "20.0.10",
		"typescript": "5.9.3",
		"vite": "7.2.2",
		"vite-plugin-pwa": "1.1.0",
		"vitest": "4.0.9",
		"vue-tsc": "3.1.3",
		"workbox-window": "7.3.0"
	}
}
