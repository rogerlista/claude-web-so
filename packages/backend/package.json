{
  "name": "@pos-nfce/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API - Sistema POS com NFC-e",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite-node --watch src/index.ts",
    "build": "vite build && tsc --emitDeclarationOnly",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage .tsbuildinfo"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@vitest/coverage-v8": "latest",
    "@vitest/ui": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-node": "latest",
    "vitest": "latest"
  }
}
